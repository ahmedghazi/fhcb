{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "inputs": [
        {
          "local": true,
          "include": ["package.json", "pnpm-lock.yaml"]
        }
      ],
      "commands": [
        "npm install -g pnpm@10.33.2",
        "pnpm install --frozen-lockfile"
      ]
    }
  }
}
