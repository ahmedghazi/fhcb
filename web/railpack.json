{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "inputs": [
        {
          "local": true,
          "include": ["package.json", "pnpm-lock.yaml"]
        }
      ],
      "commands": [
        "corepack enable",
        "corepack prepare pnpm@10.33.2 --activate",
        "pnpm install --frozen-lockfile"
      ]
    }
  }
}
